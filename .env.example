# ==========================================================================
# Sistema de Escalação de Freelancers — variáveis de ambiente
# Copie para .env e preencha. NUNCA commite o .env com valores reais.
# ==========================================================================

# Banco de dados PostgreSQL (docker-compose sobe um em localhost:5432)
DATABASE_URL="postgresql://escala:escala@localhost:5432/escala?schema=public"

# Segredo de assinatura da sessão (JWT). Gere um valor forte:
#   openssl rand -base64 48
AUTH_SECRET="troque-por-um-segredo-forte-de-pelo-menos-32-caracteres"

# Cifragem da chave PIX dos trabalhadores em repouso (AES-256-GCM).
# Exatamente 32 bytes em base64. Gere com:
#   openssl rand -base64 32
# Trocar esta chave torna ilegíveis as chaves PIX já gravadas — rotacionar exige
# decifrar com a antiga e regravar com a nova.
PIX_ENCRYPTION_KEY=""

# URL pública da aplicação
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Contato do Encarregado de Dados (DPO) exibido na Política de Privacidade (LGPD)
NEXT_PUBLIC_DPO_EMAIL="privacidade@exemplo.com.br"
